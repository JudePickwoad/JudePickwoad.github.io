---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/projectCard.astro";
import { projects } from "../data/projects.js";
---

<Layout title="Projects">
  <!-- TOP CONTAINER -->
  <div class="uk-section uk-section-secondary uk-light">
    <div class="uk-container" data-uk-parallax="y: 0,50; easing:0; opacity:0.2">
      <div
        class="tt-norms"
        data-uk-scrollspy="cls: uk-animation-slide-right-medium; target: > *; delay: 150"
      >
        <h1
          class="uk-text-primary uk-margin-small-bottom tt-norms-bold"
          style="font-size: 70px;"
        >
          Projects ⚒️
        </h1>
        <h3 class="uk-margin-remove-top tt-norms">
          Some of the things I've worked on.
        </h3>
        <br />
      </div>
    </div>
  </div>

  <!-- PROJECTS SECTION -->
  <section>
    <div class="uk-container uk-position-relative uk-margin-top">
      <div id="project-cards" class="tt-norms">
        <h3
          class="uk-text-center uk-margin-large-top tt-norms-bold"
          style="font-size: 30px;"
        >
          Academic and Extracurricular Projects 📚
        </h3>

        <!-- PROJECT GRID -->
        <div class="uk-child-width-1-3@m uk-grid-match uk-grid-medium" uk-grid>
            {projects.map((project) => (
              <div>
                <ProjectCard project={project} />
              </div>
            ))}
        </div>

        <!-- RESUME LINK -->
        <div class="uk-text-center uk-dark uk-padding">
          <a
            data-uk-icon="icon: arrow-right; ratio: 2"
            style="font-size: 18px; margin-top: 4rem; color: black;"
            href="/resume"
          >
            Checkout my resume
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
